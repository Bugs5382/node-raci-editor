{
  "name": "node-raci-editor",
  "version": "1.0.0",
  "description": "Generic drop-in React rules editor, simulator and settings for RACI-style access rules, with a pure TypeScript decide() and shared test vectors.",
  "author": "Shane",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./demo": {
      "import": {
        "types": "./dist/demo.d.mts",
        "default": "./dist/demo.mjs"
      },
      "require": {
        "types": "./dist/demo.d.cts",
        "default": "./dist/demo.cjs"
      }
    },
    "./demo.css": "./dist/demo.css",
    "./styles.css": "./dist/styles.css",
    "./vectors/decide.json": "./dist/vectors/nearest.json",
    "./vectors/nearest.json": "./dist/vectors/nearest.json",
    "./vectors/ordered.json": "./dist/vectors/ordered.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "config": {
    "packMaxUnpackedBytes": 910000,
    "packMaxGrowthPercent": 25
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bugs5382/node-raci-editor.git"
  },
  "homepage": "https://github.com/Bugs5382/node-raci-editor#readme",
  "bugs": {
    "url": "https://github.com/Bugs5382/node-raci-editor/issues"
  },
  "scripts": {
    "build": "tsdown && node scripts/buildCss.mjs && node scripts/buildVectors.mjs && npm run demo:build",
    "check:pack": "node scripts/checkPack.mjs",
    "check:pack:growth": "node scripts/checkPackGrowth.mjs",
    "check:install": "node scripts/checkInstall.mjs",
    "clean": "rm -rf dist docs coverage",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "dev": "tsdown --watch",
    "docs": "typedoc",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@bugs5382/node-oxlint-config": "^1.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.22.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "raci-editor-demo": "./bin/raci-editor-demo.mjs"
  }
}
